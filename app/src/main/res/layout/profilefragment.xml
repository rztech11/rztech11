<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FDE68A">
    <!-- Profile Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFF"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:layout_margin="8dp">

        <!-- Avatar / Icon -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="40sp"
            android:layout_marginBottom="8dp" />

        <!-- Greeting -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hi, Guest"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="6dp" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: Not set"
            android:textSize="14dp"
            android:textColor="#555555"
            android:layout_marginBottom="4dp" />


        <!-- Theme (we’ll skip theme logic for now, but keep view) -->
        <TextView
            android:id="@+id/tvProfileTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme: Not set"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="4dp" />

        <!-- Notifications -->
        <TextView
            android:id="@+id/tvProfileNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifications: Disabled"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="10dp" />

        <!-- Info / Empty State Message -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No preferences saved yet.\nGo to Settings to add your profile."
            android:textSize="14sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</LinearLayout>
